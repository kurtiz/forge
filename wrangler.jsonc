/**
 * Forge - Cloudflare Worker configuration.
 *
 * One Worker hosts the TanStack Start app, the JSON API, and the run engine
 * Durable Object. Internal boundaries live in `src/server/*` rather than in
 * separate Workers: see docs/architecture.md for why.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forge",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	/**
	 * Scheduled monitoring. The trigger is a fixed 15-minute tick; each project
	 * carries its own cadence and the handler only starts the runs that are due,
	 * so one trigger serves every cadence the UI offers.
	 */
	"triggers": {
		"crons": ["*/15 * * * *"]
	},

	"vars": {
		"FORGE_ENV": "development",
		"APP_URL": "http://localhost:3000"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "forge",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "infrastructure/migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "EVIDENCE",
			"bucket_name": "forge-evidence"
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "RUN_SESSION",
				"class_name": "RunSessionDO"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RunSessionDO"]
		}
	],


	"ai": { "binding": "AI" },

	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "forge_runs"
		}
	]
}
