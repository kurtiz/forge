{
  "name": "@forge/cli",
  "version": "0.3.0",
  "description": "Verify a deployed web application from your terminal. AI writes the code. Forge proves it works.",
  "type": "module",
  "private": true,
  "bin": {
    "forge": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm sync-version && bun scripts/build.mjs",
    "compile": "pnpm sync-version && bun scripts/compile.mjs --native",
    "compile:all": "pnpm sync-version && bun scripts/compile.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
