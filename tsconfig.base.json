{
  /* Settings both packages agree on. Everything that differs between a browser
     bundle and a Node CLI - module system, lib, emit - is left to the package
     that owns it, so neither has to override the other. */
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
